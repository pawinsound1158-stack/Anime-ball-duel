local function Tog(lbl,key,cb) local row=Instance.new("Frame",Content);row.Size=UDim2.new(1,0,0,40) row.BackgroundColor3=Color3.fromRGB(18,18,28);row.BorderSizePixel=0 Instance.new("UICorner",row).CornerRadius=UDim.new(0,8) local l=Instance.new("TextLabel",row);l.Size=UDim2.new(1,-70,1,0);l.Position=UDim2.new(0,12,0,0) l.BackgroundTransparency=1;l.Text=lbl;l.TextColor3=Color3.fromRGB(210,210,210) l.TextSize=13;l.Font=Enum.Font.Gotham;l.TextXAlignment=Enum.TextXAlignment.Left local tog=Instance.new("TextButton",row);tog.Size=UDim2.new(0,52,0,26);tog.Position=UDim2.new(1,-60,0.5,-13) tog.BackgroundColor3=Settings[key] and Color3.fromRGB(200,40,40) or Color3.fromRGB(40,40,60) tog.Text=Settings[key] and "ON" or "OFF";tog.TextColor3=Color3.new(1,1,1) tog.TextSize=12;tog.Font=Enum.Font.GothamBold;tog.BorderSizePixel=0 Instance.new("UICorner",tog).CornerRadius=UDim.new(0,6) tog.MouseButton1Click:Connect(function() Settings[key]=not Settings[key] tog.BackgroundColor3=Settings[key] and Color3.fromRGB(200,40,40) or Color3.fromRGB(40,40,60) tog.Text=Settings[key] and "ON" or "OFF" if cb then cb(Settings[key]) end end) end

local function Sld(lbl,key,mn,mx,cb) local row=Instance.new("Frame",Content);row.Size=UDim2.new(1,0,0,54) row.BackgroundColor3=Color3.fromRGB(18,18,28);row.BorderSizePixel=0 Instance.new("UICorner",row).CornerRadius=UDim.new(0,8) local l=Instance.new("TextLabel",row);l.Size=UDim2.new(1,-10,0,22);l.Position=UDim2.new(0,12,0,4) l.BackgroundTransparency=1;l.Text=lbl..": "..Settings[key] l.TextColor3=Color3.fromRGB(210,210,210);l.TextSize=12;l.Font=Enum.Font.Gotham;l.TextXAlignment=Enum.TextXAlignment.Left local tr=Instance.new("Frame",row);tr.Size=UDim2.new(1,-24,0,8);tr.Position=UDim2.new(0,12,0,36) tr.BackgroundColor3=Color3.fromRGB(35,35,55);tr.BorderSizePixel=0 Instance.new("UICorner",tr).CornerRadius=UDim.new(1,0) local pct=(Settings[key]-mn)/(mx-mn) local fi=Instance.new("Frame",tr);fi.Size=UDim2.new(pct,0,1,0) fi.BackgroundColor3=Color3.fromRGB(200,40,40);fi.BorderSizePixel=0 Instance.new("UICorner",fi).CornerRadius=UDim.new(1,0) local drag=false tr.InputBegan:Connect(function(i)if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then drag=true end end) tr.InputEnded:Connect(function(i)if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then drag=false end end) tr.InputChanged:Connect(function(i) if drag and(i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseMovement) then local r=math.clamp((i.Position.X-tr.AbsolutePosition.X)/tr.AbsoluteSize.X,0,1) local v=math.floor(mn+r*(mx-mn));Settings[key]=v;fi.Size=UDim2.new(r,0,1,0);l.Text=lbl..": "..v if cb then cb(v) end end end) end

local function Btn(lbl,cb) local b=Instance.new("TextButton",Content);b.Size=UDim2.new(1,0,0,38) b.BackgroundColor3=Color3.fromRGB(200,40,40);b.Text=lbl b.TextColor3=Color3.new(1,1,1);b.TextSize=13;b.Font=Enum.Font.GothamBold;b.BorderSizePixel=0 Instance.new("UICorner",b).CornerRadius=UDim.new(0,8) b.MouseButton1Click:Connect(cb) end

Sec("⚡ MOVEMENT") Tog("Speed Hack","SpeedEnabled",function(on) local h=LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") if h then h.WalkSpeed=on and Settings.SpeedValue or 16 end end) Sld("Speed","SpeedValue",16,250,function(v) if Settings.SpeedEnabled then local h=LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") if h then h.WalkSpeed=v end end end) Tog("Fly","FlyEnabled",function(on) if on then local c=LocalPlayer.Character;if not c then return end local r=c:FindFirstChild("HumanoidRootPart");if not r then return end local h=c:FindFirstChildOfClass("Humanoid");if h then h.PlatformStand=true end FlyBV=Instance.new("BodyVelocity");FlyBV.MaxForce=Vector3.new(1e5,1e5,1e5);FlyBV.Velocity=Vector3.zero;FlyBV.Parent=r FlyBG=Instance.new("BodyGyro");FlyBG.MaxTorque=Vector3.new(1e5,1e5,1e5);FlyBG.D=100;FlyBG.Parent=r Flying=true else Flying=false if FlyBV then FlyBV:Destroy() end;if FlyBG then FlyBG:Destroy() end local h=LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") if h then h.PlatformStand=false end end end) Sld("Fly Speed","FlySpeed",10,300) Tog("Infinite Jump","InfiniteJump")

