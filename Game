-- fly mobile btns local fb=Instance.new("Frame",ScreenGui) fb.Size=UDim2.new(0,90,0,100);fb.Position=UDim2.new(1,-100,1,-120);fb.BackgroundTransparency=1 local function FB(pos,txt,dir) local b=Instance.new("TextButton",fb);b.Size=UDim2.new(0,80,0,42);b.Position=pos b.BackgroundColor3=Color3.fromRGB(18,18,35);b.Text=txt;b.TextColor3=Color3.new(1,1,1) b.TextSize=14;b.Font=Enum.Font.GothamBold;b.BorderSizePixel=0 Instance.new("UICorner",b).CornerRadius=UDim.new(0,10) local held=false b.InputBegan:Connect(function(i)if i.UserInputType==Enum.UserInputType.Touch then held=true end end) b.InputEnded:Connect(function(i)if i.UserInputType==Enum.UserInputType.Touch then held=false end end) RunService.Heartbeat:Connect(function() if held and Settings.FlyEnabled and Flying and FlyBV then FlyBV.Velocity=Vector3.new(0,dir*Settings.FlySpeed,0) end end) end FB(UDim2.new(0,0,0,0),"▲ UP",1) FB(UDim2.new(0,0,1,-42),"▼ DOWN",-1)

RunService.Heartbeat:Connect(function() if Settings.SpeedEnabled then local h=LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") if h and h.WalkSpeed~=Settings.SpeedValue then h.WalkSpeed=Settings.SpeedValue end end if Settings.FlyEnabled and Flying and FlyBV and FlyBG then FlyBG.CFrame=Camera.CFrame end if Settings.AutoDodge then local r=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") if r then for _,o in pairs(Workspace:GetDescendants()) do if o:IsA("BasePart") and o.Name:lower():find("ball") then if(o.Position-r.Position).Magnitude<Settings.DodgeRadius then r.CFrame=r.CFrame+(r.Position-o.Position).Unit*4 end end end end end if Settings.AntiVoid then local r=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") if r and r.Position.Y<-80 then r.CFrame=CFrame.new(0,10,0) end end end)

game:GetService("UserInputService").JumpRequest:Connect(function() if Settings.InfiniteJump then local h=LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end end end)

task.spawn(function() while true do task.wait(0.5) if Settings.AutoSpin then local r=ReplicatedStorage:FindFirstChild("Spin") or ReplicatedStorage:FindFirstChild("GachaSpin") or ReplicatedStorage:FindFirstChild("Roll") if r then if r:IsA("RemoteEvent") then r:FireServer() elseif r:IsA("RemoteFunction") then pcall(function()r:InvokeServer()end) end end end end end)

